{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clearings files and external-AI proposals",
  "description": "Structural schema. The application additionally validates links, reachability, cycles, cross-document references, safe link protocols, filename rules, ancestor locks, and proposal base hashes. Do not insert $schema into checklist data: unknown application fields are refused.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/index"
    },
    {
      "$ref": "#/$defs/workspace"
    },
    {
      "$ref": "#/$defs/proposal"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,200}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "number"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "label": {
          "type": "string",
          "maxLength": 200000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "maxLength": 200000,
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "maxLength": 200000
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "order",
        "parents",
        "label",
        "tags",
        "text",
        "detail",
        "requires"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 200000
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200000
        },
        "href": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "title",
        "href"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "checklist-studio-document",
            "local-companion-checklist"
          ]
        },
        "schemaVersion": {
          "const": 2
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 200000,
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200000
        },
        "description": {
          "type": "string",
          "maxLength": 200000
        },
        "footer": {
          "type": "string",
          "maxLength": 200000
        },
        "archived": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/branch"
              },
              "maxItems": 2000
            },
            "roots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              },
              "maxItems": 20000
            }
          },
          "required": [
            "branches",
            "roots",
            "items"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "view": {
          "type": "object",
          "properties": {
            "collapsed": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "collapsed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "documentId",
        "title",
        "subtitle",
        "description",
        "footer",
        "archived",
        "updatedAt",
        "references",
        "model",
        "state",
        "view"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,190}\\.json$"
        }
      },
      "required": [
        "id",
        "file"
      ],
      "additionalProperties": false
    },
    "tracked": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "checklistId": {
          "$ref": "#/$defs/id"
        },
        "itemId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "checklistId",
        "itemId"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "checklist-studio-index",
            "local-companion-checklist-index"
          ]
        },
        "schemaVersion": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "libraryId": {
          "$ref": "#/$defs/id"
        },
        "defaultChecklist": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "maxItems": 1000
        },
        "tracked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tracked"
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "library": {
              "type": "boolean"
            },
            "tracked": {
              "type": "boolean"
            },
            "map": {
              "type": "boolean"
            },
            "theme": {
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            "showProgress": {
              "type": "boolean"
            },
            "progressFormat": {
              "enum": [
                "percent",
                "count"
              ]
            },
            "groupProgress": {
              "enum": [
                "children",
                "flat"
              ]
            },
            "progressVisual": {
              "enum": [
                "bar",
                "pie"
              ]
            },
            "rollup": {
              "type": "boolean"
            },
            "autosave": {
              "type": "boolean"
            },
            "saveDelay": {
              "enum": [
                1000,
                3000,
                5000
              ]
            },
            "motion": {
              "enum": [
                "system",
                "reduce"
              ]
            },
            "openTopChecklist": {
              "type": "boolean"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "library",
            "tracked",
            "map",
            "theme"
          ],
          "additionalProperties": false
        },
        "activity": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "at": {"type": "string", "format": "date-time"},
              "actor": {"type": "string", "minLength": 1, "maxLength": 80},
              "role": {"enum": ["human", "assistant"]},
              "action": {"enum": ["new", "updated", "completed", "reopened"]},
              "checklistId": {"$ref": "#/$defs/id"},
              "itemId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
              "approvedBy": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 80}, {"type": "null"}]},
              "highlight": {"type": "boolean"},
              "unread": {"type": "boolean"}
            },
            "required": ["id", "at", "actor", "role", "action", "checklistId", "itemId", "approvedBy", "highlight", "unread"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "libraryId",
        "defaultChecklist",
        "entries",
        "tracked",
        "preferences"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "preferences": {
                "type": "object",
                "properties": {
                  "library": {
                    "type": "boolean"
                  },
                  "tracked": {
                    "type": "boolean"
                  },
                  "map": {
                    "type": "boolean"
                  },
                  "theme": {
                    "enum": [
                      "system",
                      "light",
                      "dark"
                    ]
                  }
                },
                "required": [
                  "library",
                  "tracked",
                  "map",
                  "theme"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "preferences": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "groupProgress"
                      ]
                    },
                    {
                      "required": [
                        "progressVisual"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"schemaVersion": {"const": 3}}},
          "then": {"properties": {"preferences": {"not": {"anyOf": [{"required": ["openTopChecklist"]}, {"required": ["displayName"]}]}}}}
        },
        {
          "if": {"properties": {"schemaVersion": {"const": 4}}},
          "then": {"required": ["activity"], "properties": {"preferences": {"required": ["library", "tracked", "map", "theme", "openTopChecklist", "displayName"]}}}
        }
      ]
    },
    "workspace": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "checklist-studio-workspace",
            "local-companion-checklist-workspace"
          ]
        },
        "schemaVersion": {
          "const": 1
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "index",
        "documents"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "format": {
          "const": "checklist-studio-changes"
        },
        "schemaVersion": {
          "const": 1
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "baseSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add-item"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/id"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "item": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/item"
                      },
                      {
                        "properties": {
                          "requires": {
                            "maxItems": 0
                          }
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "op",
                  "parentId",
                  "item"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "update-item"
                  },
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "changes": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 200000,
                        "minLength": 1
                      },
                      "detail": {
                        "type": "string",
                        "maxLength": 200000
                      },
                      "label": {
                        "type": "string",
                        "maxLength": 200000
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "parents": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [],
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "required": [
                  "op",
                  "id",
                  "changes"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "reorder"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/id"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "itemIds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "op",
                  "parentId",
                  "itemIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set-done"
                  },
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "done": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "op",
                  "id",
                  "done"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "documentId",
        "baseSha256",
        "operations"
      ],
      "additionalProperties": false
    }
  }
}
